# Copy to .env (same directory as the script) or export these variables.
# Blank values count as unset, and exported values win over this file.

# Comma separated addresses to listen on: localhost plus the private network IP
# that the companion will reach, e.g. 127.0.0.1,<private-ip>
JONI_BRIDGE_HOST=

# Listening port.
JONI_BRIDGE_PORT=

# Optional with defaults shown in the script:
JONI_BRIDGE_TIMEOUT=
