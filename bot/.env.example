# Copy to .env (same directory as the script) or export these variables.
# Keep this file out of version control: it holds the bot token.
# Blank values count as unset, and exported values win over this file.

# Bot token from Developer Portal -> Bot -> Reset Token.
JONI_BOT_TOKEN=

# Channel id where the single status message is posted and edited.
JONI_BOT_CHANNEL=

# URL of the running health bridge, e.g. http://127.0.0.1:1919/
JONI_BRIDGE_URL=

# Optional with defaults shown in the script:
JONI_BOT_POLL=
JONI_BOT_RETRY_MAX=
