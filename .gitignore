# secrets: never commit real config
# .env.example files ARE tracked on purpose: the "!" line below re-includes them
# (git uses the LAST matching pattern, so it overrides ".env.*").
.env
*.env
.env.*
!.env.example
bot/bot.env
companion/config.env

# python
__pycache__/
*.pyc
venv/
.venv/

# runtime artifacts
*.log
.ruff_cache/

# systemd
/etc/joni/secrets.env
