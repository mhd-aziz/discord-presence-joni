[Unit]
Description=Joni Hermes status Discord bot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/media/bazyngan/DATA/Documents/Projects/joni/bot
EnvironmentFile=/etc/joni/secrets.env
Environment=JONI_BRIDGE_URL=http://127.0.0.1:1919/
Environment=PYTHONUNBUFFERED=1
ExecStart=/media/bazyngan/DATA/Documents/Projects/joni/bot/venv/bin/python /media/bazyngan/DATA/Documents/Projects/joni/bot/bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
