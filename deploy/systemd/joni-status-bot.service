[Unit]
Description=Joni status Discord bot
After=network-online.target
Wants=network-online.target

[Service]
# Replace /path/to/discord-presence-joni with the real checkout path.
WorkingDirectory=/path/to/discord-presence-joni/bot
EnvironmentFile=/etc/joni/secrets.env
EnvironmentFile=-/etc/joni/bot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/path/to/discord-presence-joni/bot/venv/bin/python /path/to/discord-presence-joni/bot/bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
