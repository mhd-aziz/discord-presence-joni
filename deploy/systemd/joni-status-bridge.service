[Unit]
Description=Joni status bridge (health endpoint for Discord presence)
After=network-online.target
Wants=network-online.target

[Service]
# Replace /path/to/discord-presence-joni with the real checkout path.
WorkingDirectory=/path/to/discord-presence-joni/bridge
EnvironmentFile=-/etc/joni/bridge.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /path/to/discord-presence-joni/bridge/bridge.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
