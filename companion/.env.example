# Copy to .env (same directory as the script) or export these variables.
# Blank values count as unset, and exported values win over this file.

# Discord application ID: Developer Portal, General Information -> Application ID.
JONI_CLIENT_ID=

# URL of the running health bridge, e.g. http://<bridge-host>:1919/
JONI_BRIDGE_URL=

# Optional with defaults shown in the script:
JONI_POLL=
JONI_TIMEOUT=
JONI_DISCORD_PROC=
JONI_CLEAR_AFTER=
JONI_LOG=
JONI_DRY_RUN=
