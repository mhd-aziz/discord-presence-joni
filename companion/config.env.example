# Copy to config.env and adjust. Every value is also readable from the environment.
JONI_CLIENT_ID=1530105931482791956
JONI_BRIDGE_URL=http://100.82.26.92:1919/
JONI_POLL=15
JONI_TIMEOUT=4
# process names that mean "Discord desktop is open" on .12 (comma separated)
JONI_DISCORD_PROC=Discord,discord
# consecutive offline polls before presence is cleared
JONI_CLEAR_AFTER=3
# 1 = print the computed activity without connecting to Discord
JONI_DRY_RUN=0
